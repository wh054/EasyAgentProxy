{
  "mode": "Environment",
  "targetPath": "C:\\Path\\To\\Codex.exe",
  "targetArguments": [
    "--disable-quic",
    "--proxy-server=socks5://127.0.0.1:7890",
    "--proxy-bypass-list=localhost;127.0.0.1;::1;<local>"
  ],
  "workingDirectory": null,
  "proxyUri": "socks5://127.0.0.1:7890",
  "logDirectory": "logs",
  "minimumLogLevel": "Information",
  "captureChildOutput": true,
  "injectProxyEnvironment": true,
  "waitForExit": true,
  "runDiagnosticsBeforeLaunch": true,
  "abortLaunchWhenDiagnosticsFail": false,
  "enableCodexQqSkin": false,
  "noProxy": [
    "localhost",
    "127.0.0.1",
    "::1"
  ],
  "diagnostics": {
    "tcpConnectTimeoutMs": 3000,
    "testProxyHandshake": true,
    "testProxyConnect": false,
    "testProxyTlsHandshake": true,
    "connectTestHost": "example.com",
    "connectTestPort": 443
  }
}
